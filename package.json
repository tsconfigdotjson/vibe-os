{
  "name": "vibe-os",
  "version": "0.1.0",
  "description": "A terminal multiplexer in the browser. Runs on a blank VPS, serves on port 80, and SSHes back into the box with browser-held keys and short-lived certificates.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vibe-os": "bin/vibe-os.mjs"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "fetch-wasm": "node scripts/fetch-wasm.mjs",
    "//postinstall": "Best-effort: the server fetches ssh.wasm on first start if this does not. `|| exit 0` covers the case where the script itself is unreachable, which --soft-fail cannot catch.",
    "postinstall": "node scripts/fetch-wasm.mjs --if-missing --soft-fail || exit 0",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:compress": "node scripts/compress.mjs",
    "build": "npm run fetch-wasm -- --if-missing && npm run build:web && npm run build:compress && npm run build:server",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "dev:server": "tsc -p tsconfig.server.json --watch --preserveWatchOutput",
    "dev": "vite",
    "start": "node bin/vibe-os.mjs start"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  },
  "keywords": [
    "ssh",
    "terminal",
    "multiplexer",
    "xterm",
    "wasm",
    "tmux",
    "vps"
  ]
}
