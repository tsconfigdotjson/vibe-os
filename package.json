{
  "name": "@tsconfigdotjson/vibe-os",
  "version": "0.6.6",
  "description": "A coding desktop in the browser, on a box you own. Git worktrees per piece of work, terminals that survive a reload, and SSH that runs in the tab.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/tsconfigdotjson/vibe-os#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsconfigdotjson/vibe-os.git"
  },
  "bugs": "https://github.com/tsconfigdotjson/vibe-os/issues",
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "vibe-os": "bin/vibe-os.mjs"
  },
  "files": [
    "bin",
    "server",
    "shared",
    "dist/web",
    "scripts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "fetch-wasm": "bun scripts/fetch-wasm.mjs",
    "postinstall": "bun scripts/gen-assets.ts && bun scripts/fetch-wasm.mjs --if-missing --soft-fail || exit 0",
    "build:web": "vite build",
    "build:compress": "bun scripts/compress.mjs",
    "build:assets": "bun scripts/gen-assets.ts",
    "build": "bun run fetch-wasm -- --if-missing && bun run build:web && bun run build:compress && bun run build:assets",
    "compile": "bun scripts/compile.ts",
    "notices": "bun scripts/notices.ts",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test",
    "dev": "vite",
    "dev:server": "bun --hot bin/vibe-os.mjs start --port 7681 --no-token",
    "start": "bun bin/vibe-os.mjs start"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@xterm/headless": "6.0.0",
    "acme-client": "^5.4.0",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "keywords": [
    "ssh",
    "terminal",
    "multiplexer",
    "xterm",
    "wasm",
    "dtach",
    "vps",
    "bun"
  ]
}
