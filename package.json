{
  "name": "vibe-os",
  "version": "0.1.0",
  "description": "A terminal multiplexer in the browser. Runs on a blank VPS, serves on port 80, and SSHes back into the box with browser-held keys and short-lived certificates.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.2"
  },
  "bin": {
    "vibe-os": "bin/vibe-os.mjs"
  },
  "files": [
    "bin",
    "server",
    "dist/web",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "fetch-wasm": "bun scripts/fetch-wasm.mjs",
    "postinstall": "bun scripts/gen-assets.ts && bun scripts/fetch-wasm.mjs --if-missing --soft-fail || exit 0",
    "build:web": "vite build",
    "build:compress": "bun scripts/compress.mjs",
    "build:assets": "bun scripts/gen-assets.ts",
    "build": "bun run fetch-wasm -- --if-missing && bun run build:web && bun run build:compress && bun run build:assets",
    "compile": "bun scripts/compile.ts",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "dev": "vite",
    "dev:server": "bun --hot bin/vibe-os.mjs start --port 7681 --no-token",
    "start": "bun bin/vibe-os.mjs start"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "drizzle-kit": "^0.31.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swr": "^2.5.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  },
  "keywords": [
    "ssh",
    "terminal",
    "multiplexer",
    "xterm",
    "wasm",
    "tmux",
    "vps",
    "bun"
  ]
}
